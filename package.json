{
  "name": "pfsa-academy",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && tsc -p backend/tsconfig.json && vite build",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node --import tsx --watch backend/server.ts",
    "start": "node backend/dist/backend/server.js",
    "db:init": "node --import tsx backend/cli.ts init",
    "admin:setup": "node --import tsx backend/cli.ts admin",
    "data:backup": "node --import tsx backend/cli.ts backup",
    "data:purge": "node --import tsx backend/cli.ts purge"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
