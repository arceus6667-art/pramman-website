# Node.js 24.13+ LTS required. Copy to .env; never commit .env.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DATA_DIR=./data
UPLOADS_DIR=./uploads
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Set a real monitored academy address before accepting applications.
PRIVACY_CONTACT_EMAIL=
RETENTION_DAYS=180
SESSION_HOURS=8
# Set only for npm run admin:setup; delete these lines after provisioning.
ADMIN_USERNAME=
ADMIN_PASSWORD=
